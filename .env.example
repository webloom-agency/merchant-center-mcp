# Google Merchant Center MCP — Environment Configuration
# Copy this file to .env and fill in your actual values.

# ===== Per-User OAuth 2.1 (multi-user, recommended for hosted deployments) =====
# Set to "true" to enable per-user OAuth 2.1 authentication (DCR + token issuance).
# When disabled, the server uses the legacy single-user mode below.
MCP_ENABLE_OAUTH21=true

# OAuth 2.0 client used to talk to Google.  Create a "Web application" client in
# Google Cloud Console with the redirect URI set to <this_server>/oauth2callback.
GOOGLE_OAUTH_CLIENT_ID=your_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here

# Public URL Google should redirect back to after consent.
# Locally:    http://localhost:8000/oauth2callback
# On Render:  https://your-merchant-mcp.onrender.com/oauth2callback
GOOGLE_OAUTH_REDIRECT_URI=https://your-merchant-mcp.onrender.com/oauth2callback

# Public URL of this server (used in OAuth metadata + redirects behind Render's proxy).
MERCHANT_MCP_EXTERNAL_URL=https://your-merchant-mcp.onrender.com

# Local-only base (used to build the redirect URI when EXTERNAL_URL is unset).
MERCHANT_MCP_BASE_URI=http://localhost
PORT=8000

# Per-user credential storage.
# Mount Render Persistent Disk at /data and point this here so OAuth state survives restarts.
GOOGLE_MCP_CREDENTIALS_DIR=/data/credentials

# OAuth state persistence (DCR clients + MCP access/refresh tokens).
MCP_OAUTH_STATE_PERSIST=true
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_REFRESH_TOKEN_TTL_SECONDS=2592000

# ===== Merchant Center config =====

# Read-only guardrail. Blocks POST/PATCH/DELETE except :search and :render*.
GOOGLE_MERCHANT_READ_ONLY=1

# Optional default Merchant Center account ID so callers can omit `account_id`.
DEFAULT_MERCHANT_ACCOUNT_ID=

# ===== Transport / CORS =====

# MCP HTTP path (defaults to /mcp).
MCP_HTTP_PATH=/mcp

# Comma-separated allowlist of CORS origins (the server still allow-lists "*" for the
# streamable HTTP endpoint by default; this var is reserved for future restriction).
MCP_CORS_ORIGINS=https://bolt.new,https://claude.ai

# ===== Legacy single-user mode (only used when MCP_ENABLE_OAUTH21 is false) =====

# Path to a token JSON file (created by InstalledAppFlow) or to a directory in
# which `google_merchant_token.json` should be saved.
# GOOGLE_MERCHANT_CREDENTIALS_PATH=/abs/path/to/credentials.json

# Auth type for legacy mode. Only "oauth" is currently supported (Merchant API
# does not accept service-account tokens directly).
# GOOGLE_MERCHANT_AUTH_TYPE=oauth

# Pre-issued refresh token for headless local dev (skips InstalledAppFlow).
# GOOGLE_MERCHANT_REFRESH_TOKEN=

# Single-secret transport guard (used when MCP_ENABLE_OAUTH21=false).
# MCP_BEARER_TOKEN=some-long-random-string
